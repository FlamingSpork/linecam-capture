polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.login1.reboot-multiple-sessions" && subject.user == "pi"){
        return polkit.Result.YES;
    }
});

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.login1.power-off-multiple-sessions" && subject.user == "pi"){
        return polkit.Result.YES;
    }
});
